# ==============================================================================
# BlackRoad OS API Gateway Configuration
# ==============================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace-me-with-secure-secret

# Internal Service URLs
SERVICE_API_URL=http://localhost:4100
SERVICE_OPERATOR_URL=http://localhost:4200
SERVICE_CORE_URL=http://localhost:4300
SERVICE_PRISM_URL=http://localhost:4400

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_ALLOWLIST=127.0.0.1

# ==============================================================================
# Platform Integrations
# ==============================================================================

# Railway
ENABLE_RAILWAY=true
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# Cloudflare
ENABLE_CLOUDFLARE=true
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Vercel
ENABLE_VERCEL=true
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# DigitalOcean
ENABLE_DIGITALOCEAN=true
DIGITALOCEAN_TOKEN=
DO_DEFAULT_REGION=nyc1

# Docker
ENABLE_DOCKER=true
DOCKER_HOST=
DOCKER_REGISTRY_URL=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# ==============================================================================
# Tool Integrations (iOS/iPadOS/Desktop)
# ==============================================================================

# Warp Terminal (always enabled)
WARP_TEAM_ID=

# Working Copy Git Client
WORKING_COPY_URL_KEY=

# Shellfish SSH (configuration only)
# Pyto Python IDE (configuration only)

# ==============================================================================
# Productivity Service Integrations
# ==============================================================================

# Asana
ENABLE_ASANA=false
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_ID=
ASANA_DEFAULT_PROJECT_ID=

# Notion
ENABLE_NOTION=false
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_DEPLOYMENTS_DB_ID=
NOTION_INCIDENTS_DB_ID=

# ==============================================================================
# Authentication Integrations
# ==============================================================================

# Clerk
ENABLE_CLERK=false
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=

# ==============================================================================
# Payment Integrations
# ==============================================================================

# Stripe
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# AI/ML Integrations
# ==============================================================================

# Hugging Face
ENABLE_HUGGINGFACE=false
HUGGINGFACE_API_KEY=
HF_DEFAULT_MODEL=meta-llama/Meta-Llama-3-70B-Instruct
HF_INFERENCE_ENDPOINT=

# Open Source Models Registry
OSS_MODELS_PROVIDER=huggingface
OSS_ENABLED_MODELS=llama-3-70b,mixtral-8x22b,mistral-7b,phi-3-medium

# ==============================================================================
# Network/Tunneling Integrations
# ==============================================================================

# Cloudflare Tunnels
ENABLE_TUNNELS=false
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_SECRET=
TUNNEL_PROVIDER=cloudflare

# ngrok
NGROK_AUTH_TOKEN=
NGROK_REGION=us

# ==============================================================================
# GitHub Integration (for workflows)
# ==============================================================================

GITHUB_TOKEN=
GITHUB_REPOSITORY=BlackRoad-OS/blackroad-os-api-gateway

# ==============================================================================
# Raspberry Pi Fleet
# ==============================================================================

PI_LUCIDIA_HOST=192.168.4.38
PI_BLACKROAD_HOST=192.168.4.64
PI_MYSTERY_HOST=192.168.4.49
PI_SSH_USER=pi
PI_SSH_KEY_PATH=~/.ssh/blackroad_pi
